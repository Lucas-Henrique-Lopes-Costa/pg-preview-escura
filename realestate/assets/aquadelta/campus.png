  <section id="caracteristicas" class="my-16">
    <div class="flex flex-wrap naranja text-center justify-evenly sm:justify-between w-[95%] sm:w-[70%] mx-auto items-center ">
      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none">+200 <span class="block poppins text-[12px] sm:text-[16px]">Hectáreas</span>
      </p>

      <div class="block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="300"></div>
      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="400">11 <span class="block poppins text-[12px] sm:text-[16px]">Barrios</span></p>

      <div class="hidden sm:block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="500"></div>
      <p class="hidden sm:block newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="600">97 <span class="block poppins text-[12px] sm:text-[16px]">Lotes residenciales<br>Etapa 1</span></p>

      <div class="block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="700"></div>
      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="800">600m2 <span class="block poppins text-[12px] sm:text-[16px]">Promedio por lote</span></p>

      <div class="block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="900"></div>
      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="1000">46.395m2 <span class="block poppins text-[12px] sm:text-[16px]">Área deportiva</span></p>
    </div>

    <div class="flex flex-wrap naranja text-center justify-evenly sm:justify-between w-[95%] sm:w-[48%] mx-auto items-center mt-8 ">
      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="1100"> <span class=" text-[24px] newsreader">USD</span>75.000<span class="block poppins text-[12px] sm:text-[16px] mb-1">Lotes unifamiliares
          desde</span> </p>

      <div class="block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="1200"></div>

      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="1300"> 25% <span class="block poppins text-[12px] sm:text-[16px] mb-1">Entrega inicial</span> </p>

      <div class="block w-[1px] h-16 2xl:h-24" style="background-color:#ff8b00" data-aos="fade-up" data-aos-delay="1400"></div>

      <p class="newsreader text-[1.5em] sm:text-[3em] leading-none" data-aos="fade-up" data-aos-delay="1500"> <span class=" text-[24px] newsreader">USD</span>810 <span class="block poppins text-[12px] sm:text-[16px] mb-1">Cuotas
          desde<br>Financiación a 10 años</span> </p>
    </div>
